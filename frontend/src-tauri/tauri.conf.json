{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Traceweave",
  "version": "0.1.0",
  "identifier": "local.traceweave.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Traceweave · 知径", "width": 1100, "height": 720 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:5173",
      "capabilities": []
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
